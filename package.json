{
  "name": "larp-components",
  "version": "3.0.0-alpha.9",
  "description": "Browser-based React/Three.js factory layout editor and discrete-time simulator (Larp Components 5.1, V3 prerelease).",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ar3yom4ik/Larp-Components.git"
  },
  "engines": {
    "node": ">=20.19.0 <23 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "bench:typescript": "node scripts/bench-typescript.mjs",
    "test:typescript-parity": "node scripts/bench-typescript.mjs --parity",
    "build": "vite build && node scripts/embed-assets.mjs",
    "preview": "vite preview",
    "test:browser": "node tests/browser.mjs && node tests/code-and-tablet.mjs && node tests/features.mjs && node tests/v1-graphics.mjs",
    "test:archive-browser": "node tests/project-archive.mjs",
    "test:signals-browser": "node tests/signal-ports.mjs && node tests/signal-drag.mjs",
    "test:interaction-browser": "node tests/signals-and-windows.mjs",
    "test:gizmos-browser": "node tests/scene-gizmos.mjs",
    "test:factory-browser": "node tests/factory-graph-browser.mjs && node tests/factory-graph-qol-browser.mjs",
    "test:factory-standalone": "node tests/factory-graph-standalone.mjs",
    "bench:physics": "node scripts/bench-physics.mjs",
    "test:physics-browser": "node tests/physics-browser.mjs",
    "test:physics-standalone": "node tests/physics-standalone.mjs",
    "test:speed-browser": "node tests/simulation-speed-browser.mjs",
    "test:startup-browser": "node tests/startup-fallback-browser.mjs",
    "test:speed-standalone": "node tests/simulation-speed-standalone.mjs",
    "test:catalog-browser": "node tests/catalog-browser.mjs",
    "test:camera-browser": "node tests/camera-settings-browser.mjs",
    "test:sensor-browser": "node tests/sensor-mounted-browser.mjs",
    "test:factory-signal-browser": "node tests/factory-signal-nodes-browser.mjs",
    "test:selection-browser": "node tests/selection-browser.mjs && node tests/selection-physics-browser.mjs",
    "test:web-catalog-browser": "node tests/web-catalog-browser.mjs",
    "test:web-catalog-live": "node tests/web-catalog-live.mjs",
    "test:alpha7-browser": "node tests/alpha7-browser.mjs && node tests/factory-new-features-browser.mjs && node tests/import-placement-browser.mjs && node tests/render-theme-browser.mjs",
    "test:alpha8-browser": "node tests/material-surfaces-browser.mjs && node tests/multi-pallet-browser.mjs && node tests/port-snap-browser.mjs && node tests/emissive-mrt-browser.mjs",
    "bench:beam": "node scripts/bench-beam.mjs",
    "multiplayer": "node scripts/multiplayer/server.mjs",
    "build:multiplayer": "node scripts/build-multiplayer.mjs",
    "test:multiplayer-server": "node tests/multiplayer-server.mjs",
    "test:multiplayer-browser": "node tests/multiplayer-browser.mjs",
    "package:multiplayer": "node scripts/package-multiplayer.mjs",
    "test:depalletize-browser": "node tests/depalletize-browser.mjs",
    "test:multiplayer-standalone": "node tests/multiplayer-standalone.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "cannon-es": "^0.20.0",
    "clsx": "2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.63.0",
    "occt-import-js": "^0.0.23",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.187.0",
    "ws": "^8.22.1",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "0.28.2",
    "playwright": "^1.64.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.0"
  }
}
