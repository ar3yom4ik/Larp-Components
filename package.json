{
  "name": "larp-components",
  "version": "3.0.0-alpha.2",
  "description": "Browser-based React/Three.js factory layout editor and discrete-time simulator (Larp Components 5.1, V3 prerelease).",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ar3yom4ik/Larp-Components.git"
  },
  "engines": {
    "node": ">=20.19.0 <23 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build:rust": "node scripts/build-rust-kernel.mjs",
    "test:rust": "cargo test --manifest-path rust/larp-kernel/Cargo.toml --offline",
    "typecheck": "tsc --noEmit",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "bench:hybrid": "node scripts/bench-hybrid.mjs",
    "bench:typescript": "node scripts/bench-typescript.mjs",
    "test:typescript-parity": "node scripts/bench-typescript.mjs --parity",
    "build": "vite build && node scripts/embed-assets.mjs",
    "preview": "vite preview",
    "test:browser": "node tests/browser.mjs && node tests/code-and-tablet.mjs && node tests/features.mjs && node tests/v1-graphics.mjs",
    "test:archive-browser": "node tests/project-archive.mjs",
    "test:signals-browser": "node tests/signal-ports.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "clsx": "2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.63.0",
    "occt-import-js": "^0.0.23",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "0.28.2",
    "playwright": "^1.64.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.0"
  }
}
